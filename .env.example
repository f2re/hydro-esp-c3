# Optional factory build defaults.
# A normal build does NOT need this file and intentionally embeds no Wi-Fi secret.
# If WIFI_SSID is empty, first boot opens the HydroESP-Setup access point.

export WIFI_SSID=""
export WIFI_PASSWORD=""
export TIMEZONE_OFFSET="3"

# Release/CI may override these automatically.
# export HYDRO_VERSION="v1.0.0"
